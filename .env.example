# OfferShield Backend Environment Configuration

# Google Gemini API Key (Required for AI NLP analysis; without it, system uses deterministic rules)
GEMINI_API_KEY=

# Gemini Model Name (Default: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated list or * for local dev)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Input Validation Constraints
MAX_TEXT_LENGTH=10000
MIN_TEXT_LENGTH=5
